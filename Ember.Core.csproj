<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <!-- MovementSystem 的列指针收集需要指针转换。 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <RootNamespace>Ember.Core</RootNamespace>
        <AssemblyName>Ember.Core</AssemblyName>
        <EmberFrameworkDir Condition="'$(EmberFrameworkDir)' == ''">$(MSBuildThisFileDirectory)../Ember.Framework</EmberFrameworkDir>
        <EmberRuntimeDll Condition="'$(EmberRuntimeDll)' == ''">$(MSBuildThisFileDirectory)../Ember.Package/Runtime/Ember.dll</EmberRuntimeDll>
        <EmberGeneratorDll Condition="'$(EmberGeneratorDll)' == ''">$(MSBuildThisFileDirectory)../Ember.Package/RoslynAnalyzers/Ember.Generator.dll</EmberGeneratorDll>
        <EmberPackageDir Condition="'$(EmberPackageDir)' == ''">$(MSBuildThisFileDirectory)../Ember.Core.Package</EmberPackageDir>
        <EmberDeployPackageSources Condition="'$(EmberDeployPackageSources)' == ''">false</EmberDeployPackageSources>
        <!-- tests/ 是独立测试工程。必须从默认通配项整体排除：只写 Compile Remove 时，
             tests 下的文件仍留在 None 里，进而进入 CandidateAssemblyFiles。
             而 AssemblySearchPaths 的顺序是 {CandidateAssemblyFiles};{HintPathFromItem}，
             于是 Reference 会命中 tests 输出目录里的旧 DLL，HintPath 形同虚设。 -->
        <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Ember">
            <HintPath>$(EmberRuntimeDll)</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(EmberFrameworkDir)/libs/UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <HintPath>$(EmberFrameworkDir)/libs/Unity.Collections.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <HintPath>$(EmberFrameworkDir)/libs/Unity.Mathematics.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- 显式 Burst 策略（EmberJobCompilationMode.Burst）要求编译期可解析 Unity.Burst 类型，
             否则源生成器报 EMBER005。仅编译引用，运行时由 com.unity.burst 包提供。 -->
        <Reference Include="Unity.Burst">
            <HintPath>$(MSBuildThisFileDirectory)libs/Unity.Burst.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Analyzer Include="$(EmberGeneratorDll)" />
    </ItemGroup>

    <!-- 发布测试：把源码同步进公开包库（源码包形态，不再发 DLL）。
         为什么是源码：预编译 DLL 里的 [BurstCompile] 不会被 Unity 的 Burst ILPP 处理，
         Job 会退回托管路径；源码包由 Unity 编译才行。详见 CLAUDE.md「发布流程」。
         工具本体在 Ember.Framework/tools/ 下。 -->
    <Target Name="DeployPackageSources" AfterTargets="Build"
            Condition="'$(EmberDeployPackageSources)' == 'true'">
        <Exec Command="python3 &quot;$(EmberFrameworkDir)/tools/deploy-package-sources.py&quot; --source &quot;$(MSBuildThisFileDirectory).&quot; --package &quot;$(EmberPackageDir)&quot; --name com.ember.core --runtime-asmdef Ember.Core.Runtime --runtime-root-namespace Ember.Core --runtime-refs &quot;Ember.Runtime,Unity.Collections,Unity.Mathematics,Unity.Burst&quot;" />
    </Target>

</Project>
